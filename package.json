{
  "name": "cet4-study-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:test": "vite build && vite preview --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "bundle:check": "tsx scripts/check-bundle-budget.mts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.mts",
    "content:generate": "tsx scripts/generate-content.mts && tsx scripts/expand-mock-content.mts",
    "content:audit": "tsx scripts/audit-content.mts",
    "audio:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-audio.ps1 && tsx scripts/sync-audio-timings.mts",
    "audio:audit": "tsx scripts/audio-manifest.mts",
    "pages:verify": "tsx scripts/verify-github-pages-build.mts",
    "runtime:verify": "tsx scripts/verify-runtime-config.mts",
    "supabase:verify": "tsx scripts/verify-supabase-migrations.mts",
    "release:verify": "pnpm content:validate && pnpm content:audit && pnpm audio:audit && pnpm test --run && pnpm e2e && pnpm typecheck && pnpm lint && pnpm build && pnpm bundle:check && pnpm pages:verify && pnpm supabase:verify && pnpm runtime:verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
